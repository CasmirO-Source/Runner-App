# Copy this file to .env and fill in the values from the Supabase dashboard
# (Project Settings > API). Only these two public values belong here.
#
# Never put the service role key, secret key, database password or any other
# secret in this file, in .env, or anywhere in the app. The app bundle is public.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
