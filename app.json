{
  "expo": {
    "name": "Runner App",
    "slug": "runner-app",
    "version": "0.1.0",
    "scheme": "runnerapp",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Runner App reads only the screenshot you pick, to log your run.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
